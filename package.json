{
  "name": "avatar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Realtime Gaussian-splatting head avatar you can talk to, rendered in the browser.",
  "scripts": {
    "start": "node server/server.mjs",
    "build": "node tools/make-avatar.mjs",
    "build:web": "node tools/build-web.mjs",
    "preview": "node tools/preview.mjs --out preview.png --yaw 0.2 --dist 0.62",
    "import": "node tools/import-mesh.mjs",
    "check": "node tools/check-avatar.mjs assets/me.avtr",
    "fixture": "node tools/make-test-glb.mjs --out /tmp/test-head.glb && node tools/import-mesh.mjs --in /tmp/test-head.glb --out /tmp/test-head.avtr",
    "dev": "node server/server.mjs",
    "import:lam": "node tools/import-lam.mjs",
    "fixture:lam": "node tools/make-test-lam.mjs --out /tmp/lam-test && node tools/import-lam.mjs --in /tmp/lam-test --out /tmp/lam-test.avtr",
    "paint:mouth": "node tools/paint-mouth.mjs --in assets/me.avtr --out assets/me.avtr",
    "smoke": "node tools/smoke.mjs",
    "voices": "node tools/voices.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
