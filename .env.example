# Copy to .env and fill in what you have. The server loads it on start; real
# process env vars always win. Nothing here is required — with no keys the demo
# runs on the canned LLM and macOS `say`.

# ---------------------------------------------------------------- LLM -------
# openai | deepseek | anthropic | stub
# If unset, the server picks openai when OPENAI_API_KEY exists, anthropic when
# ANTHROPIC_API_KEY exists, deepseek when DEEPSEEK_API_KEY exists, and stub
# otherwise.
# LLM_PROVIDER=deepseek

# --- DeepSeek ---
# One key is enough: provider, base URL, and model are chosen automatically.
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# --- OpenAI, or any OpenAI-compatible endpoint ---
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Ollama / LM Studio (no key needed for localhost):
# LLM_PROVIDER=openai
# OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# LLM_MODEL=llama3.2

# --- Anthropic ---
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-haiku-4-5
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Shared between providers. LLM_TEMPERATURE is only sent when set; use "none"
# to omit it for reasoning models that reject the parameter.
# LLM_SYSTEM=You are a friendly, concise conversational partner.
# LLM_TEMPERATURE=0.7
# LLM_MAX_TOKENS=400
# LLM_TIMEOUT_MS=90000

# ---------------------------------------------------------------- TTS -------
# elevenlabs | say | none
# If unset, ELEVENLABS_API_KEY selects ElevenLabs; otherwise macOS uses `say`
# and other platforms fall back to synthetic babble. `say` is local-only; the
# Cloudflare Worker supports elevenlabs or none.
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=...

# Find a voice with: npm run voices
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_VOICE_NAME=Rachel
# eleven_turbo_v2_5 (balanced) | eleven_flash_v2_5 (lowest latency) | eleven_multilingual_v2
# ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
# Must be raw PCM; the server has no MP3 decoder.
# ELEVENLABS_OUTPUT_FORMAT=pcm_22050
# ELEVENLABS_STABILITY=0.45
# ELEVENLABS_SIMILARITY=0.75
# ELEVENLABS_STYLE=0
# ELEVENLABS_SPEED=1
# ELEVENLABS_SPEAKER_BOOST=true
# ELEVENLABS_LANGUAGE_CODE=en
# ELEVENLABS_REQUEST_STITCHING=true
# ELEVENLABS_RETRIES=2
# ELEVENLABS_TIMEOUT_MS=30000
# Bounded LRU of generated segments; 0 disables it. TTS is billed per character.
# TTS_CACHE_SIZE=32

# ---------------------------------------------------------------- STT -------
# Speech to text, for the microphone button. elevenlabs | openai | none
# If unset, ELEVENLABS_API_KEY selects Scribe, then OPENAI_API_KEY selects
# Whisper; with neither, voice input is off and typing still works.
#
# The key still decides whether it works: a key without the speech_to_text
# permission fails at the first recording. Enable the permission on the key
# (ElevenLabs -> profile -> API keys); keys are scoped per permission, so a
# text_to_speech-only key is not enough.
# STT_PROVIDER=elevenlabs
# ELEVENLABS_STT_MODEL=scribe_v2
# OPENAI_STT_MODEL=whisper-1
# Only if Whisper lives somewhere other than the LLM's endpoint (a local
# whisper.cpp server, for example). Defaults to OPENAI_BASE_URL.
# OPENAI_STT_BASE_URL=http://127.0.0.1:8080/v1

# ISO 639-1 or 639-3 (en, eng). Leave unset to let the model detect it.
# STT_LANGUAGE=en

# The browser uploads 16 kHz mono WAV (~32 kB/s); anything larger is rejected.
# STT_MAX_AUDIO_MB=8
# STT_TIMEOUT_MS=30000
# STT_RETRIES=1

# Send 16 kHz WAV to Scribe as headerless PCM (pcm_s16le_16), which skips its
# decode step. false always uploads a container.
# ELEVENLABS_STT_PCM=true

# ---------------------------------------------------------------- server ----
# PORT=8787
# HOST=127.0.0.1

# ---------------------------------------------------------- cloudflare ------
# Used by worker/index.mjs. The local Node server ignores these.
# Best-effort per-IP turns per minute, per isolate. 0 disables it.
# RATE_LIMIT_PER_MINUTE=20
